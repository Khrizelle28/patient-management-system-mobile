<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Medication Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Medication Name"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextMedicationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Start Day Selection Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Day"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/dayMonday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="M"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dayTuesday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="T"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dayWednesday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="W"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dayThursday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="Th"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dayFriday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="F"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/daySaturday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="Sa"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/daySunday"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="Su"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:background="@drawable/day_button_unselected"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Prescribed Pieces Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prescribed Pieces"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextPrescribedPieces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Times Per Day Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Times Per Day"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerTimesPerDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/day_button_unselected"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- First Dose Time Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="First Dose Time"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextFirstDoseTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:drawableEnd="@android:drawable/ic_menu_recent_history" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Automatically Computed Schedule Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Automatically Computed Schedule"
        android:textSize="12sp"
        android:textColor="#757575"
        android:textStyle="italic"
        android:layout_marginBottom="16dp" />

    <!-- Remarks/Description Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Remarks (Optional)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
