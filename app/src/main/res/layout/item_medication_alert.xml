<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Time Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Time and Day -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/textViewTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7:00"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/textViewDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Sunday"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginLeft="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Period and Medication -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AM"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" - "
                    android:textSize="14sp"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/textViewMedicationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amoxicillin"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginLeft="8dp" />

            </LinearLayout>

            <!-- Remarks -->
            <TextView
                android:id="@+id/textViewRemarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Take after meal"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Duration Info -->
            <TextView
                android:id="@+id/textViewDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Everyday for 7 days"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Toggle Switch -->
        <Switch
            android:id="@+id/switchMedication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

    <!-- Progress Bar Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <!-- Days of Week Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/dayMonday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="M"
                android:textSize="10sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dayTuesday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="T"
                android:textSize="10sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dayWednesday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="W"
                android:textSize="10sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dayThursday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="Th"
                android:textSize="9sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dayFriday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="F"
                android:textSize="10sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/daySaturday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="Sa"
                android:textSize="9sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/daySunday"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="Su"
                android:textSize="9sp"
                android:textColor="#2196F3"
                android:gravity="center"
                android:background="@drawable/day_button_unselected"
                android:layout_margin="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Progress:"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/textViewProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0/1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4A90E2"
                android:layout_marginLeft="8dp" />

            <Button
                android:id="@+id/buttonMarkTaken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Mark as Taken"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#27AE60"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Segmented Progress Bar Container -->
        <LinearLayout
            android:id="@+id/segmentedProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="1" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Edit"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#4A90E2"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginRight="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Delete"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#E74C3C"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>

</androidx.cardview.widget.CardView>
